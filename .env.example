# Sao chép file này thành `.env` (chỉ dùng cho phát triển local, KHÔNG commit).
# Các giá trị dưới đây CHỈ LÀ VÍ DỤ — thay bằng giá trị thật của bạn.
# Trên production, dùng Cloudflare Worker Secrets thay vì file .env.

# Token của Telegram Bot, lấy từ @BotFather.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Secret tự đặt để xác thực webhook Telegram (chuỗi ngẫu nhiên, dài).
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret

# API key của XingchiAPI (https://api.xingchiapi.com).
XINGCHI_API_KEY=your-xingchi-api-key

# Model mặc định (phải là model ID do /v1/models trả về). Để trống nếu chưa biết.
DEFAULT_MODEL=

# Số token tối đa cho mỗi câu trả lời của AI.
MAX_OUTPUT_TOKENS=1024

# Số tin nhắn tối đa giữ lại trong lịch sử mỗi chat.
MAX_HISTORY_MESSAGES=20

# Số tin nhắn tối đa mỗi người dùng trong một phút.
RATE_LIMIT_PER_MINUTE=20

# Danh sách Telegram user ID được phép dùng bot, cách nhau bằng dấu phẩy.
# Để trống = cho phép mọi người dùng.
ALLOWED_USER_IDS=
